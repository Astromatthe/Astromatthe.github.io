@inproceedings{zieser_investigation_2026,
	title = {Investigation of an {Alternating} {Current} {Magnetohydrodynamic} {Drive} {Demonstrator} for a {Microgravity} {Photobioreactor} {Concept}},
	url = {https://hdl.handle.net/2346/108992},
	doi = {10.32865/2346/108992},
	abstract = {Compared to conventional pumping methods, alternating current magnetohydrodynamic (AC-MHD) drives could offer key benefits for microalgae cultivation and potentially other fluid-based systems in space. Photobioreactors, a promising long-term approach for air revitalization, wastewater treatment, and food production, could be improved in aspects such as phase separation, mechanical cell stress, and reliability. This paper examines the performance and feasibility of the AC-MHD concept using data collected from a demonstrator developed within the Magnetohydrodynamic Vortex-Inducing Photobioreactor Experiment (MVIPER) for the ESA Academy Parabolic Flight Campaign of 2025. To accelerate an electrolyte, the demonstrator utilizes the Lorentz force generated by synchronized electric currents and magnetic fields. By alternating the direction of both electric and magnetic fields, the AC-based drive largely avoids the generation of electrolysis byproducts, a major drawback of DC-MHD propulsion systems. The AC-MHD drive consists of four sets of electrodes and electromagnets that accelerate the fluid in a transparent, circular chamber. The resulting flow speeds, system characteristics, and drive performance were measured using a high-speed camera setup, tracer particles, and a sensor and measurement setup. The system accelerates 230 g of electrolyte with a conductivity of 10 mS/cm up to 10 rpm. It utilizes a drive frequency range of DC to 1 kHz, electrode and magnet voltages of 5.5 to 25 V, and up to 308 W of output power. The AC-MHD operates at about 1/10 to 1/100 the performance of MVIPER's DC-MHD drive while greatly reducing electrolytic reactions. Measurements indicate a significant dependence of drive performance on the operating frequency. Analyzing results across different operating modes demonstrates the benefits of AC operation and reveals potential for system optimization. Furthermore, the demonstrator and gathered data provide the basis for further investigation of system feasibility and future designs of AC-MHD photobioreactor concepts.},
	urldate = {2026-10-18},
	booktitle = {55th {International} {Conference} on {Environmental} {Systems}},
	publisher = {International Conference on Environmental Systems},
	author = {Zieser, Alexander and Tomasik, Jona and Laub, Philipp and Martín-Canrilero, Pablo and Kura, Matthias and Taame, Ilyasse and Salman, Lina and Metten, Luisa and Schäfer, Fabio and Obersteiner, Katharina and Volk, Lucien and Mascher, Matteo and Detrell, Gisela and Romero-Calvo, Álvaro},
	month = jul,
	year = {2026},
}
